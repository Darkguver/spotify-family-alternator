# Spotify Developer app credentials (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=vul_hier_je_client_id_in
SPOTIFY_CLIENT_SECRET=vul_hier_je_client_secret_in
# Moet exact overeenkomen met de Redirect URI die je in het Spotify dashboard invult
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# Willekeurige lange geheime string, gebruikt om de sessie-cookie te ondertekenen
SESSION_SECRET=verander-dit-in-iets-lang-en-willekeurigs

# Standaard playlists (kunnen ook later via de webinterface ingesteld worden)
KIDS_PLAYLIST_ID=
ADULTS_PLAYLIST_ID=
